<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101828">

    <!-- Everyday view: status + the one next step. Diagnostics live in the left menu. -->
    <LinearLayout android:id="@+id/contentRoot" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:focusable="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="jin" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Run a DeltaChat bot from this phone" android:textColor="#98A2B3" android:textSize="13sp" />
        </LinearLayout>

        <ScrollView android:id="@+id/contentScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:clipToPadding="false">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg" android:padding="16dp">
                    <TextView android:id="@+id/statusTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#F59E0B" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="#D0D5DD" android:textSize="14sp"
                        android:textIsSelectable="true" />
                    <TextView android:id="@+id/statusMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="#98A2B3" android:textSize="12sp" />
                </LinearLayout>

                <Button android:id="@+id/primaryButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:minHeight="52dp" android:textAllCaps="false"
                    android:textSize="15sp" android:textStyle="bold"
                    android:background="@drawable/btn_square_amber" android:textColor="#101828" />

                <Button android:id="@+id/publishButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:minHeight="48dp" android:textAllCaps="false"
                    android:text="Publish new mini app (.xdc) version"
                    android:background="@drawable/btn_square_dark" android:textColor="#D0D5DD" />

                <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:minHeight="48dp" android:textAllCaps="false"
                    android:text="Stop bot"
                    android:background="@drawable/btn_square_dark" android:textColor="#D0D5DD" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:layout_marginBottom="20dp"
                    android:text="Diagnostics, logs and export: swipe from the left edge, or long-press anywhere."
                    android:textColor="#475467" android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Left-edge menu: diagnostics and one-time moves stay out of the everyday view -->
    <LinearLayout android:id="@+id/drawerPane" android:layout_width="300dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical" android:background="#1D2939"
        android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Diagnostics" android:textStyle="bold" android:textColor="#475467" android:paddingBottom="8dp" />
        <TextView android:id="@+id/menuLogs" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="View logs" android:minHeight="48dp" android:gravity="center_vertical" android:focusable="true"
            android:textColor="#D0D5DD" android:textSize="14sp" />
        <TextView android:id="@+id/menuProbe" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Run offline validation probe" android:minHeight="48dp" android:gravity="center_vertical" android:focusable="true"
            android:textColor="#D0D5DD" android:textSize="14sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:background="#344054" />
        <TextView android:id="@+id/menuApps" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Connected apps" android:minHeight="48dp" android:gravity="center_vertical" android:focusable="true"
            android:textColor="#D0D5DD" android:textSize="14sp" />
        <TextView android:id="@+id/menuPairBidik" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pair Bidik capture device" android:minHeight="48dp" android:gravity="center_vertical" android:focusable="true"
            android:textColor="#D0D5DD" android:textSize="14sp" />
        <TextView android:id="@+id/menuExport" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Export bot for tindak" android:minHeight="48dp" android:gravity="center_vertical" android:focusable="true"
            android:textColor="#98A2B3" android:textSize="14sp" />
        <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="#475467" android:textSize="11sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
